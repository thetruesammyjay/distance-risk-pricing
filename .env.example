APP_ENV=development
APP_NAME=distance-risk-pricing
DEBUG=true

# Leave blank to use the in-memory repository for local development.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
FRONTEND_URL=http://localhost:3000
LOCATION_CATALOG_PATH=data/FUTO Route Endpoint Coordinate Collection.csv

ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=10
ROUTING_RETRIES=2
ROUTING_PROFILE=driving
ROUTING_CACHE_TTL_SECONDS=300
ROUTING_CACHE_MAX_ENTRIES=512
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_RETRIES=2

# These are illustrative prototype values, not calibrated research results.
PRICING_BASE_FARE=500
PRICING_DISTANCE_RATE=150
PRICING_RISK_RATE=1
PRICING_DEMAND_SENSITIVITY=1
PRICING_DEMAND_CAP=2.5
PRICING_FORMULA_MODE=additive
PRICING_FORMULA_VERSION=v1

# Set RISK_MODE=open_meteo and use the Open-Meteo forecast endpoint for an external weather signal.
# Leave blank to use explicitly labelled simulated risk.
RISK_MODE=simulated
# RISK_MODE=open_meteo with RISK_PROVIDER_URL=https://api.open-meteo.com/v1/forecast
RISK_PROVIDER_URL=
RISK_PROVIDER_API_KEY=
RISK_ACCIDENT_WEIGHT=0.4
RISK_ROAD_WEIGHT=0.3
RISK_SECURITY_WEIGHT=0.3

# Set DEMAND_MODE=tomtom_traffic with a TomTom Traffic Flow API key for an external traffic-pressure proxy.
DEMAND_MODE=simulated
# DEMAND_MODE=tomtom_traffic with DEMAND_PROVIDER_URL=https://api.tomtom.com/traffic/services/4/flowSegmentData/absolute/10/json
DEMAND_PROVIDER_URL=
DEMAND_PROVIDER_API_KEY=

# Optional: used only by scripts/generate_futo_route_catalog.py.
# Use a separate TomTom key with Geocoding API access.
FUTO_GEOCODING_API_KEY=
ALLOW_SIMULATED_DATA=true
SIMULATION_SEED=42
LOG_LEVEL=INFO

# Set API_AUTH_ENABLED=true and provide a random 32+ character API_KEY outside local development.
API_AUTH_ENABLED=false
API_KEY=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# In a deployed Next.js app, leave NEXT_PUBLIC_API_URL blank and set these server-only values.
# API_SERVER_URL=https://your-api.example.com
# INTERNAL_API_KEY=generate-a-long-random-secret
